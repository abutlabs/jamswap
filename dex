#!/usr/bin/env bash
# jamswap DEX control — ONE script, clear verbs. Hides the compose sprawl.
#
# Two nets run the DEX: lasair6 (the default; six lasair validators, GRANDPA) and
# NET=pj6 (six stock PolkaJam validators, no lasair). Both finalize, so fills settle
# durably. docs/NETS.md lists every net and what it is for.
#
#   ./dex rebuild     # rebuild the on-chain service blob from source (service/*.jam)
#   ./dex up          # start the net (no auto-load), wait for finality, print the URL
#   ./dex load        # start the load generator (for soak tests)
#   ./dex noload      # stop the load generator (so you trade manually)
#   ./dex status      # finality + market state at a glance
#   ./dex logs [svc]  # follow logs (default: dex)
#   ./dex down        # tear down + wipe the chain (fresh genesis next up)
#
# Other test nets (docs/NETS.md; `./dex nets` lists them): add NET=<name> to any verb.
#
#   ./dex up NET=pj6           # e.g. 6x PolkaJam GRANDPA; pj-javajam, pj-pbnjam, mixed, ...
#   ./dex heads NET=pj6 [SECS] # one head + finality across every node (default 300 s)
#   ./dex down NET=pj6
#   ./dex nets                 # the profiles;  ./dex gen  regenerates nets/compose/*.yml
#
# pj6 and pj-javajam (3 PolkaJam + 3 JavaJAM) carry the DEX on JIP-2 (no lasair anywhere):
# up deploys the service at startup and waits for the API; load/noload drive its load
# generator, and
#
#   ./dex soak NET=pj6 [SECS]  # A1-A4 (docs/NETS.md): load + netwatch for SECS (600),
#                              # then state parity and the soak verdict; exit 0 iff all pass
#
# With JavaJAM in the net, up starts it first, then the other validators and the DEX's
# gateway node, and starts a fresh net unless they all finalize together (UP_TRIES, 5).
#
# Keys: LASAIR_DEV_ALL_KEYS=1 (default on nets with lasair, until lasair#62) lets each
# lasair node sign guarantees as every lasair index; =0 narrows it to its own index.
# JAVAJAM_RUNNER=native|docker (default native on macOS, whose Docker can't run it).
#
set -euo pipefail
cd "$(dirname "$0")"

# NET=<name> may come from the environment or anywhere in the arguments
NET="${NET:-lasair6}"
rest=()
for a in "$@"; do case "$a" in NET=*) NET="${a#NET=}";; *) rest+=("$a");; esac; done
set -- ${rest[@]+"${rest[@]}"}

net_env=$(python3 nets/netgen.py env "$NET") || exit 1
eval "$net_env"
COMPOSE=(docker compose -p "$NET_PROJECT" -f "$NET_FILE")
URL=$NET_DEX_URL                     # the net's DEX UI, if it has one
STATE="${JAMSWAP_CACHE:-$HOME/.cache/jamswap}/nets/$NET_PROJECT"   # native nodes, host IP

# ---- key sharing (docs/NETS.md "Keys per client") ----------------------------------
LASAIR_DEV_ALL_KEYS="${LASAIR_DEV_ALL_KEYS:-$NET_DEV_ALL_KEYS_DEFAULT}"
if [ -z "$NET_LASAIR_SET" ]; then
  LASAIR_DEV_ALL_KEYS=0                        # no lasair node: nothing to share
elif [ "$LASAIR_DEV_ALL_KEYS" = 0 ]; then
  export LASAIR_GUARANTOR_OWN=""               # each lasair node guarantees as itself only
fi
export LASAIR_DEV_ALL_KEYS

# ---- JavaJAM: native process (macOS) or container (Linux) --------------------------
JAVAJAM_RUNNER="${JAVAJAM_RUNNER:-$([ "$(uname -s)" = Darwin ] && echo native || echo docker)}"
JJ_NATIVE=0
if [ -n "$NET_JAVAJAM" ]; then
  if [ "$JAVAJAM_RUNNER" = native ]; then
    JJ_NATIVE=1
    # every validator is addressed at the host's IP (the native node can reach no
    # container IP); pinned per net so a re-up keeps the genesis it was minted with
    if [ -z "${HOST_IP:-}" ] && [ -s "$STATE/host_ip" ]; then HOST_IP=$(cat "$STATE/host_ip"); fi
    if [ -z "${HOST_IP:-}" ]; then
      if [ "$(uname -s)" = Darwin ]; then
        HOST_IP=$(ipconfig getifaddr "$(route -n get default | awk '/interface:/{print $2}')" || true)
      else
        HOST_IP=$(ip route get 1.1.1.1 | awk '{for(i=1;i<NF;i++) if($i=="src"){print $(i+1); exit}}')
      fi
    fi
    [ -n "${HOST_IP:-}" ] || { echo "no host IP found for the native JavaJAM net: set HOST_IP"; exit 1; }
    export HOST_IP
    # its JIP-2 RPC listens on the host's loopback: containers (the dex, netwatch) reach
    # it through Docker Desktop's host.docker.internal (nets/netgen.py _jip2_url)
    export JAVAJAM_RPC_HOST="${JAVAJAM_RPC_HOST:-host.docker.internal}"
  else
    export COMPOSE_PROFILES=javajam-docker
    arch=$([ "$(uname -m)" = arm64 ] || [ "$(uname -m)" = aarch64 ] && echo arm64 || echo amd64)
    for kv in $JAVAJAM_IMAGES; do [ "${kv%%=*}" = "$arch" ] && : "${JAVAJAM_IMAGE:=${kv#*=}}"; done
    export JAVAJAM_IMAGE
  fi
fi

_finality() { curl -s --max-time 5 "$URL/api/finality" 2>/dev/null; }
_market() {
  curl -s --max-time 5 "$URL/api/state?market=1" \
    | python3 -c "import sys,json;d=json.load(sys.stdin);print('market  :',{k:d.get(k) for k in ('price','volume','pending','sealed_onchain','in_auction')})" 2>/dev/null \
    || echo "market  : (dex not up yet)"
}
_available() { _finality | python3 -c "import sys,json;print(json.load(sys.stdin).get('available',False))" 2>/dev/null || echo False; }

# start the JavaJAM validators natively once spec-init has minted the genesis
_jj_native_up() {
  for _ in $(seq 1 120); do
    st=$(docker inspect -f '{{.State.Status}} {{.State.ExitCode}}' "${NET_PROJECT}-spec-init-1" 2>/dev/null || true)
    [ "$st" = "exited 0" ] && break
    case "$st" in exited*) echo "spec-init failed ($st)"; "${COMPOSE[@]}" logs spec-init; exit 1;; esac
    sleep 1
  done
  mkdir -p "$STATE"
  echo "$HOST_IP" > "$STATE/host_ip"
  "${COMPOSE[@]}" cp spec-init:/shared/spec.json "$STATE/spec.json" >/dev/null
  nets/javajam-native.sh fetch
  for n in $NET_JAVAJAM; do
    IFS=: read -r i port rpc <<<"$n"
    nets/javajam-native.sh start "$STATE" "$STATE/spec.json" "$i" "$port" "$rpc" "$NET_FINALITY" "$HOST_IP"
  done
}

# JavaJAM is up once its JIP-2 RPC answers (it opens its QUIC endpoint before its RPC);
# its JVM takes several seconds to get there, so a fixed pause is not enough (jamswap#18)
_jj_wait() {
  local n i port rpc
  for n in $NET_JAVAJAM; do
    IFS=: read -r i port rpc <<<"$n"
    for _ in $(seq 1 120); do
      python3 -c "import sys; sys.path.insert(0, 'offchain'); import jip2
jip2.Jip2Client('ws://127.0.0.1:' + sys.argv[1], 2).call('bestBlock')" "$rpc" 2>/dev/null && break
      sleep 1
    done
  done
}

# Start a net with JavaJAM; 0 once every validator (and the DEX's gateway) finalizes.
_jj_form() {
  # JavaJAM before PolkaJam (jamswap#18): PolkaJam casts its round-1 GRANDPA vote once, as
  # it starts, and never re-sends it; JavaJAM re-sends its current-round votes to a peer
  # that connects later. PolkaJam first => round 1 never completes and finality stays at
  # genesis. So: the genesis minter, then JavaJAM, and once every JavaJAM node answers (and
  # has had a few seconds to reach the others) the other validators.
  "${COMPOSE[@]}" up -d spec-init
  if [ "$JJ_NATIVE" = 1 ]; then
    _jj_native_up
  else
    "${COMPOSE[@]}" up -d $(for n in $NET_JAVAJAM; do echo "jj${n%%:*}"; done)
  fi
  _jj_wait
  sleep 5
  # then the other validators, and the DEX's gateway node with them: a PolkaJam node that
  # joins a running net follows the head but never finalizes past the block it synced to
  # (seen on pj6 too, no JavaJAM), and the DEX reads finalized state there. Nothing else
  # until they all finalize: the start is when PolkaJam's one-shot round-1 votes must
  # reach every JavaJAM node.
  "${COMPOSE[@]}" up -d $NET_OTHER_VALIDATORS $NET_GATEWAY
  [ "$NET_FINALITY" = grandpa ] || return 0
  # a node can miss the start for good (jamswap#18: every peer of a PolkaJam node timing
  # out ~15 s in, leaving it at genesis or on one peer; round 1 never completing, so
  # nothing ever finalizes), and without finality the DEX cannot even deploy: check now,
  # 20 s to settle then 36 s of heads (the gateway's too, and at least 2 peers each),
  # rather than in a soak's verdict
  sleep 20
  local out
  if out=$(python3 nets/onehead.py "$NET" --secs 36 --gateway --min-peers 2 2>&1) \
      && grep -q "FINALITY: advancing on every node" <<<"$out"; then
    echo "✓ every validator$([ -n "$NET_GATEWAY" ] && echo " and the gateway") follows the chain and finalizes"
    return 0
  fi
  grep -E '^(best slot|finalized|HEADS|FINALITY|PEERS)' <<<"$out"
  echo "✗ the net did not form (a validator missed the start, or finality never started)"
  return 1
}

# tear the net down and wipe its chain (and stop its native nodes)
_down() {
  "${COMPOSE[@]}" down -v --remove-orphans
  if [ -n "$NET_JAVAJAM" ] && [ -d "$STATE" ]; then
    nets/javajam-native.sh stop "$STATE"
    rm -rf "$STATE"
  fi
}

cmd=${1:-help}
case "$cmd" in
  rebuild)
    # rebuild the JAM service PVM blob (the on-chain matching/settlement code) from
    # source with the GP 0.8.0 builder in tools/jam080 (no 0.8.0 SDK is published;
    # see tools/jam080/README.md). Needs cargo + the nightly-2025-05-10 toolchain.
    rustup toolchain list 2>/dev/null | grep -q '^nightly-2025-05-10' \
      || { echo "needs: rustup toolchain install nightly-2025-05-10 --component rust-src"; exit 1; }
    cargo build --release -q --manifest-path tools/jam080/builder/Cargo.toml
    echo "building service/jamswap-service.jam …"
    tools/jam080/builder/target/release/jam080-build service --out service
    echo "✓ rebuilt service/jamswap-service.jam ($(wc -c < service/jamswap-service.jam) bytes)"
    echo "  (the DEX code — offchain/ — is bind-mounted, so it needs no rebuild; just ./dex up)"
    ;;

  up)
    if [ "$NET_GENERATED" = 1 ]; then
      python3 nets/netgen.py check || { echo "run ./dex gen"; exit 1; }
      "${COMPOSE[@]}" build -q
      if [ -n "$NET_JAVAJAM" ]; then
        # a start can fail for good (see _jj_form): try fresh nets, UP_TRIES of them
        tries=${UP_TRIES:-5}
        for t in $(seq 1 "$tries"); do
          _jj_form && break
          if [ "$t" = "$tries" ]; then
            echo "✗ the net did not form in $tries fresh starts (UP_TRIES); ./dex down NET=$NET"
            exit 1
          fi
          echo "  starting a fresh net (attempt $((t + 1)) of $tries)"
          _down >/dev/null 2>&1
        done
      fi
      "${COMPOSE[@]}" up -d
      # manual trading by default, as on lasair6
      if [ "$NET_DEX_BACKEND" = jip2 ]; then "${COMPOSE[@]}" stop loadgen >/dev/null 2>&1 || true; fi
      echo "✓ $NET up: validators (index order) = $NET_CLIENTS"
      if [ "$JJ_NATIVE" = 1 ]; then echo "  JavaJAM: native processes; every validator addressed at host $HOST_IP"
      elif [ -n "$NET_JAVAJAM" ]; then echo "  JavaJAM: containers ($JAVAJAM_IMAGE)"; fi
      echo "  keys: LASAIR_DEV_ALL_KEYS=$LASAIR_DEV_ALL_KEYS$([ -z "$NET_LASAIR_SET" ] && echo " (no lasair node: every key held only by its own node)")"
      echo "  one head + finality: ./dex heads NET=$NET"
      if [ -n "$URL" ]; then
        # the API opens once the service is deployed (jip2), the markets are listed, the
        # dev accounts are funded and the treasury's reserve has landed: a minute or two
        echo "DEX starting ($([ "$NET_DEX_BACKEND" = jip2 ] && echo "runtime deploy + setup" || echo "genesis service"))…"
        for _ in $(seq 1 120); do
          _finality | grep -q available && break
          sleep 5
          printf '.'
        done
        echo
        if _finality | grep -q available; then
          echo "✓ DEX ready → $URL   (loadgen is OFF; './dex load NET=$NET' to drive it)"
        else
          echo "DEX not answering at $URL after 10 min: './dex logs NET=$NET dex'"
          exit 1
        fi
      fi
      exit 0
    fi
    # (re)build the genesis minter against the current lasair image: cached when unchanged,
    # and a stale minter would write genesis with an older lasair's encoding
    "${COMPOSE[@]}" build -q spec-init
    "${COMPOSE[@]}" up -d
    "${COMPOSE[@]}" stop loadgen >/dev/null 2>&1 || true   # manual trading by default
    if [ "$NET" = lasair6 ]; then
      echo "net starting — warming up (Safrole tickets + finality bootstrap, ~5 min)…"
      for i in $(seq 1 60); do
        [ "$(_available)" = "True" ] && { echo "✓ finality live"; break; }
        sleep 10
        printf '.'
      done
      echo
      echo "✓ DEX ready → $URL   (loadgen is OFF; './dex load' to drive it, './dex status' to watch)"
    else
      echo "✓ $NET up → $URL   (no finality on this net; './dex heads NET=$NET' to watch)"
    fi
    ;;

  load)   "${COMPOSE[@]}" start loadgen; echo "✓ loadgen ON (PROFILE from compose; sealed crossing pairs)";;
  noload) "${COMPOSE[@]}" stop loadgen;  echo "✓ loadgen OFF — trade manually at $URL";;

  down)
    _down
    echo "✓ net down, chain wiped (next ./dex up mints a fresh genesis)"
    ;;

  logs)
    svc=${2:-dex}
    if [ -f "$STATE/$svc/stdout.log" ]; then tail -f "$STATE/$svc/stdout.log"; else "${COMPOSE[@]}" logs -f "$svc"; fi
    ;;

  heads)  exec python3 nets/onehead.py "$NET" --secs "${2:-300}";;

  status)
    if [ "$NET" != lasair6 ]; then
      rc=0; python3 nets/onehead.py "$NET" --secs 0 || rc=$?
      [ -n "$URL" ] && _market
      exit $rc
    fi
    echo "finality: $(_finality)"
    _market
    ;;

  soak)   exec python3 nets/soak.py "$NET" --secs "${2:-600}";;

  nets)   python3 nets/netgen.py list;;
  gen)    python3 nets/netgen.py write && python3 nets/netgen.py check && echo "✓ nets/compose/*.yml regenerated";;

  help|*)
    awk 'NR>1 && /^#/ {sub(/^# ?/,""); print; next} NR>1 {exit}' "$0"
    ;;
esac
