#!/usr/bin/env bash
# soak/run — one soak, start to finish, with its report.
#
#   soak/run NET [SECS]          # e.g. soak/run lasair-pj 3600   (SECS default 600)
#
# Starts the observability stack if it is not up, brings the net up (./dex up), runs the
# soak (./dex soak: it records the configuration in config.json and, with the stack up,
# pushes it, its progress and its verdict to the "Soak runs" dashboard), tears the net
# down (./dex down) and writes REPORT.md next to the soak's own files in
# ~/.cache/jamswap/soak/<net>-<time>/. While it runs, watch it live: `./dex up` prints
# the dashboard links.
#
# Env passed through to the net: LASAIR_IMAGE (default: the pin in nets/profiles.py),
# LASAIR_DATA_DIR (e.g. /data: durable storage), LASAIR_DEX_BACKEND, PROFILE, RATE,
# SEALED_RATIO. KEEP_UP=1 leaves the net running afterwards.
set -uo pipefail
cd "$(dirname "$0")/.."
NET="${1:?usage: soak/run NET [SECS]}"; SECS="${2:-600}"
CACHE="${JAMSWAP_CACHE:-$HOME/.cache/jamswap}"

./dex obs ping >/dev/null 2>&1 || ./dex obs up || echo "observability stack not available: the soak runs without dashboards"

./dex up NET="$NET" || { echo "net did not come up"; exit 1; }

./dex soak NET="$NET" "$SECS"; rc=$?
dir=$(ls -dt "$CACHE"/soak/"$NET"-*/ 2>/dev/null | head -1)
dir="${dir%/}"
run_id=$(python3 -c "import json,sys; print(json.load(open(sys.argv[1])).get('run_id', ''))" "$dir/config.json" 2>/dev/null || echo "")

[ "${KEEP_UP:-0}" = 1 ] || ./dex down NET="$NET"
python3 soak/report.py "$dir" > "$dir/REPORT.md"
echo
echo "report: $dir/REPORT.md"
if [ -n "$run_id" ]; then
  echo "soak runs dashboard: $(./dex obs link "$run_id" -d soak-runs 2>/dev/null)"
fi
exit $rc
