   "description": "Rounds released without settling, by reason, and released rounds that settled after all.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "sum(increase(jamswap_round_abandoned_total{net=\"$net\",run_id=\"$run_id\"}[10m])) or on() (sum(up{net=\"$net\",run_id=\"$run_id\",job=\"dex\"}) * 0)",
     "legendFormat": "abandoned (all reasons)",
     "refId": "A",
     "range": true
