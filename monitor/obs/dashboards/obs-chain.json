  {
   "type": "timeseries",
   "title": "Best block per node (slot)",
   "description": "Slot of each node's best block. Lines climb together; one that flattens stopped importing.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "jam_best_slot{net=\"$net\",run_id=\"$run_id\"} or on(node) lasair_slot{net=\"$net\",run_id=\"$run_id\"}",
