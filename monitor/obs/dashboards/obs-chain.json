  {
   "type": "timeseries",
   "title": "Height per node (lasair: best solid, finalized dashed)",
   "description": "Blocks since genesis, as each lasair node counts them. JIP-2 (PolkaJam) reports no heights.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "lasair_block_height{net=\"$net\",run_id=\"$run_id\"}",
     "legendFormat": "{{node}} best",
     "refId": "A",
     "range": true
    },
    {
     "expr": "lasair_finalized_height{net=\"$net\",run_id=\"$run_id\"}",
     "legendFormat": "{{node}} finalized",
     "refId": "B",
     "range": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 0,
      "showPoints": "never",
      "spanNulls": false,
      "stacking": {
       "mode": "none",
       "group": "A"
      }
     },
     "color": {
      "mode": "palette-classic"
     },
     "decimals": 0,
     "min": 0
    },
    "overrides": [
     {
      "matcher": {
       "id": "byRegexp",
       "options": ".* finalized$"
