 "panels": [
  {
   "type": "text",
   "title": "",
   "transparent": true,
   "options": {
    "mode": "markdown",
    "content": "**Is the net one chain that keeps growing and finalizing, on every node?** Each line is one node: its best and finalized blocks should climb together, finality lag should stay under one epoch (12 slots), and head agreement should read one head. PolkaJam nodes are read through netwatch's JIP-2 view, which counts in slots, not heights; lasair nodes also report their own heights, so a lasair-only run (no netwatch) fills these panels from lasair's metrics."
   },
   "id": 1,
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 24,
    "h": 3
   }
  },
  {
   "type": "stat",
   "title": "Targets down (not loadgen) \u00b7 PASS = 0",
   "description": "Registered scrape targets that do not answer. The load generator is left out: it is stopped whenever load is off.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "sum(1 - up{net=\"$net\",run_id=\"$run_id\",job!=\"loadgen\"})",
     "refId": "A",
     "range": true,
     "instant": false
    }
   ],
   "fieldConfig": {
    "defaults": {
     "decimals": 0,
     "noValue": "no data",
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "red",
        "value": 1e-09
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "graphMode": "area",
    "colorMode": "background",
    "textMode": "value",
    "justifyMode": "center",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    }
   },
   "id": 2,
   "gridPos": {
    "x": 0,
    "y": 3,
    "w": 5,
    "h": 4
   }
  },
  {
   "type": "stat",
   "title": "One head \u00b7 PASS = all nodes on one block (\u2264 3 slots behind)",
   "description": "netwatch's jam_net_one_head: every node up, one block at the common slot, none more than 3 slots behind the newest. Without netwatch: lasair best heights within 3.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "min(jam_net_one_head{net=\"$net\",run_id=\"$run_id\"}) or on() ((max(lasair_block_height{net=\"$net\",run_id=\"$run_id\"}) - min(lasair_block_height{net=\"$net\",run_id=\"$run_id\"})) <= bool 3)",
     "refId": "A",
     "range": true,
     "instant": false
    }
   ],
   "fieldConfig": {
    "defaults": {
     "decimals": 0,
     "noValue": "no data",
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "green",
        "value": 1
       }
      ]
     },
     "mappings": [
      {
       "type": "value",
       "options": {
        "0": {
         "text": "FAIL",
         "color": "red"
        },
        "1": {
         "text": "PASS",
         "color": "green"
        }
       }
      }
     ]
    },
    "overrides": []
   },
   "options": {
    "graphMode": "area",
    "colorMode": "background",
    "textMode": "value",
    "justifyMode": "center",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    }
   },
   "id": 3,
   "gridPos": {
    "x": 5,
    "y": 3,
    "w": 5,
    "h": 4
   }
  },
  {
   "type": "stat",
   "title": "Finality lag, worst node \u00b7 PASS \u2264 12 slots",
   "description": "Best slot minus finalized slot on the node that lags most. netwatch's soak verdict fails a finality stall longer than one epoch (12 slots).",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "max((jam_finality_lag_slots{net=\"$net\",run_id=\"$run_id\"} and on(node) (jam_finalized_slot{net=\"$net\",run_id=\"$run_id\"} > 0)) or on(node) (lasair_slot{net=\"$net\",run_id=\"$run_id\"} - (lasair_finalized_slot{net=\"$net\",run_id=\"$run_id\"} > 0)))",
     "refId": "A",
     "range": true,
     "instant": false
    }
   ],
   "fieldConfig": {
    "defaults": {
     "decimals": 0,
     "noValue": "no data",
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "red",
        "value": 12.000000001
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "graphMode": "area",
    "colorMode": "background",
    "textMode": "value",
    "justifyMode": "center",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    }
   },
   "id": 4,
   "gridPos": {
    "x": 10,
    "y": 3,
    "w": 5,
    "h": 4
   }
  },
  {
   "type": "stat",
   "title": "Finalized in 5 min, slowest node \u00b7 PASS > 0 slots",
   "description": "How far the slowest node's finalized block moved in the last 5 minutes. 0 = finality stalled on some node.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "min((max_over_time(jam_finalized_slot{net=\"$net\",run_id=\"$run_id\"}[5m]) - min_over_time((jam_finalized_slot{net=\"$net\",run_id=\"$run_id\"} > 0)[5m:15s])) or (jam_finalized_slot{net=\"$net\",run_id=\"$run_id\"} * 0)) or on() min((max_over_time(lasair_finalized_slot{net=\"$net\",run_id=\"$run_id\"}[5m]) - min_over_time((lasair_finalized_slot{net=\"$net\",run_id=\"$run_id\"} > 0)[5m:15s])) or (lasair_finalized_slot{net=\"$net\",run_id=\"$run_id\"} * 0))",
     "refId": "A",
     "range": true,
     "instant": false
    }
   ],
   "fieldConfig": {
    "defaults": {
     "decimals": 0,
     "noValue": "no data",
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "green",
        "value": 1e-09
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "graphMode": "area",
    "colorMode": "background",
    "textMode": "value",
    "justifyMode": "center",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
