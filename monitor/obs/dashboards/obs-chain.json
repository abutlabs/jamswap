     "values": false
    }
   },
   "id": 5,
   "gridPos": {
    "x": 15,
    "y": 3,
    "w": 5,
    "h": 4
   }
  },
  {
   "type": "stat",
   "title": "Finality conflicts \u00b7 PASS = 0",
   "description": "Finalized slots seen with two different hashes (netwatch; a safety failure). No data without netwatch.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "max(jam_finality_conflicts_total{net=\"$net\",run_id=\"$run_id\"})",
     "refId": "A",
     "range": true,
     "instant": false
    }
   ],
   "fieldConfig": {
    "defaults": {
     "decimals": 0,
     "noValue": "no data",
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
