   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "(jam_finality_lag_slots{net=\"$net\",run_id=\"$run_id\"} and on(node) (jam_finalized_slot{net=\"$net\",run_id=\"$run_id\"} > 0)) or on(node) (lasair_slot{net=\"$net\",run_id=\"$run_id\"} - (lasair_finalized_slot{net=\"$net\",run_id=\"$run_id\"} > 0))",
     "legendFormat": "{{node}} \u00b7 {{client}}",
