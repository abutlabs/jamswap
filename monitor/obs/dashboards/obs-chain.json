  {
   "type": "timeseries",
   "title": "Head agreement",
   "description": "netwatch compares block hashes at the common slot across every node. Without netwatch, the spread of lasair best heights stands in.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "jam_net_heads{net=\"$net\",run_id=\"$run_id\"}",
     "legendFormat": "distinct heads at the common slot (1 = one head)",
     "refId": "A",
     "range": true
    },
    {
     "expr": "jam_net_final_heads{net=\"$net\",run_id=\"$run_id\"}",
     "legendFormat": "distinct finalized blocks (1 = agree)",
     "refId": "B",
     "range": true
    },
    {
     "expr": "max(jam_head_lag_slots{net=\"$net\",run_id=\"$run_id\"})",
     "legendFormat": "worst head lag (slots)",
     "refId": "C",
     "range": true
    },
    {
     "expr": "(max(lasair_block_height{net=\"$net\",run_id=\"$run_id\"}) - min(lasair_block_height{net=\"$net\",run_id=\"$run_id\"})) and on() absent(jam_net_heads{net=\"$net\",run_id=\"$run_id\"})",
     "legendFormat": "lasair best-height spread (no netwatch)",
     "refId": "D",
     "range": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "lineWidth": 2,
