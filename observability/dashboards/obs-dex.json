  {
   "type": "stat",
   "title": "Load turned away \u00b7 PASS \u2264 0.01%",
   "description": "Errors plus busy (503) replies over operations offered, as the soak judges the offered load. Counts restart when the load generator restarts.",
   "datasource": {
    "type": "prometheus",
