   "type": "timeseries",
   "title": "Cleared of settled orders (live)",
   "description": "The DEX's running tally over orders that reached an end (not the verdict: stuck-open orders are not in it). Dashed: the target.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "jamswap_order_clearing_slo{net=\"$net\",run_id=\"$run_id\"}",
     "legendFormat": "cleared of settled",
     "refId": "A",
     "range": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 0,
      "showPoints": "never",
      "spanNulls": false,
      "stacking": {
       "mode": "none",
       "group": "A"
      },
      "thresholdsStyle": {
       "mode": "dashed"
      }
     },
     "color": {
      "mode": "palette-classic"
     },
     "unit": "percentunit",
     "decimals": 4,
     "max": 1,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "transparent",
        "value": null
       },
       {
        "color": "red",
        "value": 0.9999
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "id": 12,
   "gridPos": {
    "x": 0,
    "y": 15,
    "w": 8,
    "h": 8
   }
  },
  {
   "type": "timeseries",
   "title": "Orders open, and open too long",
   "description": "Live orders by phase; those silent over 10 min, which the verdict will count as stuck open; and how long the oldest has gone without an event (right axis). A backlog shows here while it builds.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "sum by (phase) (jamswap_order_open{net=\"$net\",run_id=\"$run_id\"})",
     "legendFormat": "open: {{phase}}",
     "refId": "A",
     "range": true
    },
    {
     "expr": "sum(jamswap_order_open_stale{net=\"$net\",run_id=\"$run_id\"})",
     "legendFormat": "open too long (> 10 min silent)",
     "refId": "B",
     "range": true
    },
    {
     "expr": "max(jamswap_order_open_oldest_seconds{net=\"$net\",run_id=\"$run_id\"}) / 60",
     "legendFormat": "oldest silent (min)",
     "refId": "C",
     "range": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 0,
      "showPoints": "never",
      "spanNulls": false,
      "stacking": {
       "mode": "none",
       "group": "A"
      }
     },
     "color": {
      "mode": "palette-classic"
     },
     "min": 0
    },
    "overrides": [
     {
      "matcher": {
       "id": "byRegexp",
       "options": "oldest.*"
      },
      "properties": [
       {
        "id": "custom.axisPlacement",
        "value": "right"
       },
       {
        "id": "custom.lineStyle",
        "value": {
         "fill": "dash",
         "dash": [
          6,
          4
         ]
        }
       },
       {
        "id": "unit",
        "value": "m"
       }
      ]
     },
     {
      "matcher": {
       "id": "byRegexp",
       "options": "open too long.*"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "red"
        }
       }
      ]
     }
    ]
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "id": 13,
   "gridPos": {
    "x": 8,
    "y": 15,
    "w": 8,
    "h": 8
   }
