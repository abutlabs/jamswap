  {
   "type": "table",
   "title": "Soak runs, newest first",
   "description": "Every soak the Pushgateway holds (nets/soak.py pushes one group per run). Click a run id to open it above with its time range.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "max by (run_id, net, clients, lasair_image) (soak_info)",
     "refId": "A",
     "format": "table",
     "instant": true,
     "range": false
    },
    {
     "expr": "max by (run_id, net) (soak_started_timestamp_seconds) * 1000",
     "refId": "B",
     "format": "table",
     "instant": true,
     "range": false
    },
    {
     "expr": "max by (run_id, net) (soak_duration_seconds)",
     "refId": "C",
     "format": "table",
     "instant": true,
     "range": false
    },
    {
     "expr": "max by (run_id, net) (soak_check_value{check=\"clearing_slo\"})",
     "refId": "D",
     "format": "table",
     "instant": true,
     "range": false
    },
    {
     "expr": "max by (run_id, net) (soak_orders_refused)",
     "refId": "E",
     "format": "table",
     "instant": true,
     "range": false
    },
    {
     "expr": "max by (run_id, net) (soak_sealed_stuck)",
     "refId": "F",
     "format": "table",
     "instant": true,
     "range": false
    },
    {
     "expr": "max by (run_id, net) (soak_clear_latency_seconds{quantile=\"0.5\"})",
     "refId": "G",
     "format": "table",
     "instant": true,
     "range": false
    },
    {
     "expr": "max by (run_id, net) (soak_clear_latency_seconds{quantile=\"0.99\"})",
     "refId": "H",
     "format": "table",
     "instant": true,
     "range": false
    },
    {
     "expr": "max by (run_id, net) (soak_pass)",
     "refId": "I",
     "format": "table",
     "instant": true,
     "range": false
    },
    {
     "expr": "max by (run_id, net) (soak_started_timestamp_seconds) * 1000 - 60000",
     "refId": "J",
     "format": "table",
     "instant": true,
     "range": false
    },
    {
     "expr": "max by (run_id, net) ((soak_finished_timestamp_seconds or (soak_started_timestamp_seconds + soak_load_seconds + soak_drain_seconds + 900)) * 1000 + 60000)",
     "refId": "K",
     "format": "table",
     "instant": true,
     "range": false
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "align": "auto",
      "cellOptions": {
       "type": "auto"
      }
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "started"
      },
      "properties": [
       {
        "id": "unit",
        "value": "dateTimeAsIso"
       },
       {
        "id": "custom.width",
        "value": 160
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "run_id"
      },
      "properties": [
       {
        "id": "custom.width",
        "value": 250
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "net"
      },
      "properties": [
       {
        "id": "custom.width",
        "value": 90
       }
      ]
     },
     {
      "matcher": {
       "id": "byRegexp",
       "options": "^(clients|lasair image)$"
      },
      "properties": [
       {
        "id": "custom.width",
        "value": 140
       }
      ]
     },
     {
      "matcher": {
       "id": "byRegexp",
       "options": "^(duration|clearing SLO|refused|sealed stuck|latency p50|latency p99|result)$"
      },
      "properties": [
       {
        "id": "custom.width",
        "value": 106
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "duration"
      },
      "properties": [
       {
        "id": "unit",
        "value": "s"
       }
      ]
     },
     {
      "matcher": {
       "id": "byRegexp",
       "options": "latency.*"
      },
      "properties": [
       {
        "id": "unit",
        "value": "s"
       },
       {
        "id": "decimals",
        "value": 0
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "clearing SLO"
